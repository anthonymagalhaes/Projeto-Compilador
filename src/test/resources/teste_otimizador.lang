program calculoRodadas;

var
    rodadas, pontuacao, recorde: integer;

begin
    recorde := 67;
    pontuacao := 0;

    write("Digite a quantidade de rodadas: ");
    read(rodadas);


    while rodadas > 0 do
    begin
        pontuacao := pontuacao + 10;
        rodadas := rodadas - 1
    end;
    if pontuacao > recorde then
        begin
            write("Parabens! ")
        end
        else
        begin
            write("Fim de jogo. ")
        end;

    write(" Sua pontuacao final foi: ");
    write(pontuacao)
end.