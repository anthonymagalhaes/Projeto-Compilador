program calculoStreak;

var
    rodadas, pontuacao, recorde, streakFinal : integer;
    bateuRecorde : boolean;

begin
    recorde := 67;
    pontuacao := 0;
    bateuRecorde := false;

    write("Digite a streak final de rodadas: ");
    read(rodadas);
    streakFinal := rodadas;

    while rodadas > 0 do
    begin
        pontuacao := pontuacao + 10;
        rodadas := rodadas - 1
    end;
    if pontuacao > recorde then
        begin
            bateuRecorde := true;
            write("Parabens! Voce cravou a streak da rodada final de: ");
            write(streakFinal)
        end
        else
        begin
            write("Fim de jogo. Streak da rodada final: ");
            write(streakFinal)
        end;

    write(" Sua pontuacao final foi: ");
    write(pontuacao)
end.